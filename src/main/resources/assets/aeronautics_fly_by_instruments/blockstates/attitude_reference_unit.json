{
  "multipart": [
    {
      "apply": {
        "model": "aeronautics_fly_by_instruments:block/attitude_reference_unit_frame"
      }
    },
    {
      "apply": {
        "model": "aeronautics_fly_by_instruments:block/attitude_reference_unit_glass"
      }
    },
    {
      "when": {
        "nose": "north"
      },
      "apply": {
        "model": "aeronautics_fly_by_instruments:block/attitude_reference_unit_arm_nose"
      }
    },
    {
      "when": {
        "nose": "east"
      },
      "apply": {
        "model": "aeronautics_fly_by_instruments:block/attitude_reference_unit_arm_nose",
        "y": 90
      }
    },
    {
      "when": {
        "nose": "south"
      },
      "apply": {
        "model": "aeronautics_fly_by_instruments:block/attitude_reference_unit_arm_nose",
        "y": 180
      }
    },
    {
      "when": {
        "nose": "west"
      },
      "apply": {
        "model": "aeronautics_fly_by_instruments:block/attitude_reference_unit_arm_nose",
        "y": 270
      }
    },
    {
      "when": {
        "nose": "up"
      },
      "apply": {
        "model": "aeronautics_fly_by_instruments:block/attitude_reference_unit_arm_nose",
        "x": 270
      }
    },
    {
      "when": {
        "nose": "down"
      },
      "apply": {
        "model": "aeronautics_fly_by_instruments:block/attitude_reference_unit_arm_nose",
        "x": 90
      }
    },
    {
      "when": {
        "up": "north"
      },
      "apply": {
        "model": "aeronautics_fly_by_instruments:block/attitude_reference_unit_arm_up",
        "x": 90
      }
    },
    {
      "when": {
        "up": "east"
      },
      "apply": {
        "model": "aeronautics_fly_by_instruments:block/attitude_reference_unit_arm_up",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "up": "south"
      },
      "apply": {
        "model": "aeronautics_fly_by_instruments:block/attitude_reference_unit_arm_up",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "up": "west"
      },
      "apply": {
        "model": "aeronautics_fly_by_instruments:block/attitude_reference_unit_arm_up",
        "x": 90,
        "y": 270
      }
    },
    {
      "when": {
        "up": "up"
      },
      "apply": {
        "model": "aeronautics_fly_by_instruments:block/attitude_reference_unit_arm_up"
      }
    },
    {
      "when": {
        "up": "down"
      },
      "apply": {
        "model": "aeronautics_fly_by_instruments:block/attitude_reference_unit_arm_up",
        "x": 180
      }
    }
  ]
}
